<UserControl x:Class="RenaimingToolCS.Views.RenamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:RenaimingToolCS.Views"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#222222">

    <UserControl.Resources>

        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="BorderBrush" Value="#888888"/>
            <Setter Property="BorderThickness" Value="1.2"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <ScrollViewer x:Name="PART_ContentHost" 
                                          Margin="2" 
                                          VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Background" Value="#5A8DEE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" 
                                              VerticalAlignment="Center" 
                                              RecognizesAccessKey="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3C64D8" BlurRadius="6" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3C64D8"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#2B4FA3"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid Style -->
        <Style TargetType="DataGrid" x:Key="StyledDataGrid">
            <Setter Property="Background" Value="#2E2E2E"/>
            <Setter Property="Foreground" Value="#F0F0F0"/>
            <Setter Property="RowBackground" Value="#3A3A3A"/>
            <Setter Property="AlternatingRowBackground" Value="#424242"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#5A8DEE"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Margin" Value="0,8,0,12"/>
            <Setter Property="CanUserAddRows" Value="False"/>
        </Style>

        <!-- Column Header Style -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#5A8DEE"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20" x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <!-- Input Folder -->
        <TextBlock Text="Input Folder:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" 
                   Foreground="#F0F0F0" FontWeight="SemiBold" FontSize="14"/>
        <TextBox Text="{Binding InputFolderPath, UpdateSourceTrigger=PropertyChanged}" 
                 Grid.Row="0" Grid.Column="0"
                 Margin="110,0,110,0"
                 AllowDrop="True"
                 ToolTip="Drag and drop a folder here or click Browse"
                 PreviewDragOver="InputFolder_PreviewDragOver"
                 Drop="InputFolder_Drop"/>
        <Button Content="Browse" Command="{Binding BrowseInputFolderCommand}" 
                Grid.Row="0" Grid.Column="1" Width="90" Height="32"/>

        <!-- Output Folder -->
        <TextBlock Text="Output Folder:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,12,0,0" 
                   Foreground="#F0F0F0" FontWeight="SemiBold" FontSize="14"/>
        <TextBox Text="{Binding OutputFolderPath, UpdateSourceTrigger=PropertyChanged}" 
         Grid.Row="1" Grid.Column="0" Margin="110,12,110,0"
         AllowDrop="True"
         ToolTip="Drag and drop a folder here or click Browse"
         PreviewDragOver="OutputFolder_PreviewDragOver"
         Drop="OutputFolder_Drop"/>
        <Button Content="Browse" Command="{Binding BrowseOutputFolderCommand}" 
                Grid.Row="1" Grid.Column="1" Width="90" Height="32" Margin="0,12,0,0"/>

        <!-- Excel File -->
        <TextBlock Text="Excel File:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,12,0,0" 
                   Foreground="#F0F0F0" FontWeight="SemiBold" FontSize="14"/>
        <TextBox Text="{Binding ExcelFilePath, UpdateSourceTrigger=PropertyChanged}"
                 Grid.Row="2" Grid.Column="0"
                 Margin="110,12,110,0"
                 AllowDrop="True"
                 ToolTip="Drag and drop an Excel file here or click Browse"
                 PreviewDragOver="Excel_PreviewDragOver"
                 Drop="Excel_Drop"/>
        <Button Content="Browse" Command="{Binding BrowseExcelFileCommand}" Grid.Row="2" Grid.Column="1" Width="90" Height="32" Margin="0,12,0,0"/>

        <!-- DataGrid Heading -->
        <TextBlock Text="Files to Rename" Grid.Row="3" Grid.ColumnSpan="3" 
                   Foreground="#CCCCCC" FontWeight="Bold" FontSize="18" Margin="5,20,0,10"/>

        <!-- DataGrid -->
        <DataGrid ItemsSource="{Binding Files}" AutoGenerateColumns="False" 
                  Grid.Row="4" Grid.ColumnSpan="3" 
                  Style="{StaticResource StyledDataGrid}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Original Name" Binding="{Binding OriginalName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="Old Name" Binding="{Binding OldName}" IsReadOnly="True" Width="*"/>
                <DataGridTextColumn Header="New Name" Binding="{Binding NewName}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Rename Button -->
        <StackPanel Grid.Row="6" Grid.ColumnSpan="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,20,0,0"
            >

            <!-- Download Excel Button (on the left) -->
            <Button Content="Download Excel"
            Command="{Binding DownloadExcelCommand}"
            Height="40" Width="140"/>

            <!-- Rename Files Button (on the right) -->
            <Button Content="Rename Files"
            Command="{Binding RenameFilesCommand}"
            Height="40" Width="140"/>
        </StackPanel>
        <!-- Theme Toggle Button - bottom left -->
        <ToggleButton x:Name="ThemeToggleButton"
              Grid.Row="5" Grid.Column="0"
              Width="40" Height="40"
              Margin="0,20,0,0"
              FontSize="20"
              HorizontalAlignment="Left"
              ToolTip="Toggle Light/Dark Mode"
              Background="#5A8DEE"
              Foreground="White"
              BorderThickness="1.5"
              BorderBrush="White"
              Checked="ThemeToggleButton_Checked"
              Unchecked="ThemeToggleButton_Unchecked">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border CornerRadius="8"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </ToggleButton.Template>

            <TextBlock x:Name="ToggleSymbol" Text="🌙" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </ToggleButton>

    </Grid>
</UserControl>
