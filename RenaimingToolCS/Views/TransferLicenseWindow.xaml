<Window x:Class="RenaimingToolCS.Views.TransferLicenseWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RenaimingToolCS.Views"
        mc:Ignorable="d"
        Title="TransferLicenseWindow" Height="300" Width="600">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0"
                   Text="Transfer License"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- System Code -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15">
            <TextBlock Text="New System Code:" FontWeight="SemiBold"/>
            <TextBox Text="{Binding NewSystemCode, UpdateSourceTrigger=PropertyChanged}"
                     Margin="0,5,0,0"
                     Height="28"/>
        </StackPanel>

        <!-- Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <Button Content="Cancel"
                    Width="90"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"/>

            <Button Content="Transfer"
                    Width="100"
                    Background="#2980b9"
                    Foreground="White"
                    Command="{Binding ConfirmCommand}"/>
        </StackPanel>

    </Grid>

</Window>
