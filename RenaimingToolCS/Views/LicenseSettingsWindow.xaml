<Window x:Class="RenaimingToolCS.Views.LicenseSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="License Management"
        Height="480" Width="620"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#f5f5f5"
        FontFamily="Segoe UI"
        FontSize="14">

    <Grid Margin="25">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- License Management Header -->
        <TextBlock Grid.Row="0"
                   Text="License Management"
                   FontSize="16"
                   FontWeight="Bold"
                   Foreground="#2c3e50"
                   Margin="0,0,0,10"/>

        <!-- License Options — a floating license is bound to the server, not this
             machine, so Deactivate/Transfer don't apply; only Change License shows. -->
        <StackPanel Grid.Row="1"
                    Orientation="Vertical"
                    Margin="10,0,0,15"
                    Visibility="{Binding NodeLockedActionsVisibility}">

            <RadioButton Content="Deactivate License"
                         GroupName="LicenseAction"
                         IsChecked="{Binding IsDeactivateSelected}"
                         FontWeight="SemiBold"
                         Margin="0,5"/>

            <RadioButton Content="Transfer License"
                         GroupName="LicenseAction"
                         IsChecked="{Binding IsTransferSelected}"
                         FontWeight="SemiBold"
                         Margin="0,5"/>
        </StackPanel>

        <!-- Offline Use (Borrow) — only meaningful once a floating license is already
             active, since borrowing converts an existing floating activation into a
             time-boxed offline checkout rather than starting one from scratch. -->
        <StackPanel x:Name="pnlBorrowSection" Grid.Row="2" Margin="10,0,0,15">
            <TextBlock Text="Offline Use (Borrow)"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"
                       Foreground="#333"/>

            <StackPanel x:Name="pnlBorrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtBorrowAmount"
                             Text="7"
                             FontSize="14"
                             Padding="6"
                             Grid.Column="0"
                             Margin="0,0,10,0"
                             Background="White"
                             BorderBrush="#ccc"
                             BorderThickness="1"/>
                    <ComboBox x:Name="cmbBorrowUnit"
                              Width="70"
                              Grid.Column="1"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center"
                              SelectedIndex="0">
                        <ComboBoxItem Content="Days"/>
                        <ComboBoxItem Content="Hours"/>
                    </ComboBox>
                    <Button x:Name="btnBorrow"
                            Content="Borrow"
                            Width="100"
                            Grid.Column="2"
                            Click="btnBorrow_Click"
                            Background="#3498db"
                            Foreground="White"
                            BorderBrush="#2980b9"
                            BorderThickness="1"
                            Cursor="Hand"/>
                </Grid>
                <TextBlock Text="How long to borrow — the app keeps working with no network connection until you return it or this period ends (never past the license's own expiry)."
                           FontSize="11" Foreground="Gray" Margin="0,4,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="pnlBorrowActive" Visibility="Collapsed">
                <Border Background="#EFF6FF" BorderBrush="#ccc" BorderThickness="1" Padding="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtBorrowStatus"
                                   Text="Borrow active until ..."
                                   VerticalAlignment="Center"
                                   Foreground="#333"/>
                        <Button x:Name="btnReturnBorrow"
                                Content="Return"
                                Width="100"
                                Grid.Column="1"
                                Click="btnReturnBorrow_Click"
                                Background="#3498db"
                                Foreground="White"
                                BorderBrush="#2980b9"
                                BorderThickness="1"
                                Cursor="Hand"/>
                    </Grid>
                </Border>
            </StackPanel>

            <TextBlock x:Name="txtBorrowUnavailable"
                       Text="Borrowing requires an active floating license."
                       FontSize="11" Foreground="Gray" TextWrapping="Wrap"
                       Visibility="Collapsed"/>
        </StackPanel>

        <!-- Action Buttons -->
        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">

            <StackPanel.Resources>
                <!-- Rounded Button Style -->
                <Style x:Key="RoundedButtonStyle" TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="15,8">
                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.85"/>
                                        <Setter TargetName="border" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="Black"
                                                                  BlurRadius="10"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.3"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="border" Property="Opacity" Value="0.7"/>
                                        <Setter TargetName="border" Property="RenderTransform">
                                            <Setter.Value>
                                                <ScaleTransform ScaleX="0.98" ScaleY="0.98"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="border" Property="Opacity" Value="0.5"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="FontWeight" Value="Medium"/>
                </Style>
            </StackPanel.Resources>

            <Button Content="{Binding PrimaryLicenseActionText}"
                    Width="160"
                    Height="36"
                    Margin="0,0,10,0"
                    Background="#c0392b"
                    Foreground="White"
                    BorderBrush="#922b21"
                    BorderThickness="1"
                    Visibility="{Binding NodeLockedActionsVisibility}"
                    Command="{Binding PrimaryLicenseActionCommand}"
                    Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="Change License"
                    Width="150"
                    Height="36"
                    Margin="0,0,10,0"
                    Background="#8e44ad"
                    Foreground="White"
                    BorderBrush="#6c3483"
                    BorderThickness="1"
                    Command="{Binding ChangeLicenseTypeCommand}"
                    Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="Cancel"
                    Width="80"
                    Height="36"
                    Margin="0,0,10,0"
                    Command="{Binding CancelCommand}"
                    Background="#95a5a6"
                    Foreground="White"
                    BorderBrush="#7f8c8d"
                    BorderThickness="1"
                    Style="{StaticResource RoundedButtonStyle}"/>

            <Button Content="OK"
                    Width="80"
                    Height="36"
                    Command="{Binding ConfirmCommand}"
                    Background="#2980b9"
                    Foreground="White"
                    BorderBrush="#2471a3"
                    BorderThickness="1"
                    Style="{StaticResource RoundedButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
